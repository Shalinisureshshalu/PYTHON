# Circular Prime Checker

def is_prime(n):
    if n < 2:
        return False
    for i in range(2, int(n**0.5) + 1):
        if n % i == 0:
            return False
    return True
def rotations(num_str):
    return [int(num_str[i:] + num_str[:i]) for i in range(len(num_str))]
def is_circular_prime(num):
    num_str = str(num)
    for rot in rotations(num_str):
        if not is_prime(rot):
            return False
    return True
n = int(input())
if is_circular_prime(n):
    print("Circular Prime")
else:
    print("Not Circular Prime")

INPUT: 197
OUTPUT: Circular Prime

#Automorphic number

def is_automorphic(num):
    square = num ** 2
    return str(square).endswith(str(num))
n = int(input())

if is_automorphic(n):
    print("Automorphic Number")
else:
    print("Not Automorphic Number")

INPUT: 24
OUTPUT: Automorphic Number

# Peterson Number

import math
def is_peterson(num):
    total = 0
    for digit in str(num):
        total += math.factorial(int(digit))
    return total == num
n = int(input())
if is_peterson(n):
    print("Peterson Number")
else:
    print("Not Peterson Number")

INPUT: 145
OUTPUT: Peterson Number

# Spiral Matrix Printing

def spiral_order(matrix):
    result = []
    while matrix:
        result += matrix[0]
        matrix = matrix[1:]
        if not matrix:
            break
        for row in matrix:
            result.append(row[-1])
            row.pop()
        if matrix:
            result += matrix[-1][::-1]
            matrix = matrix[:-1]
        for row in matrix[::-1]:
            result.append(row[0])
            row.pop(0)
    return result
matrix = [
    [1, 2, 3],
    [4, 5, 6],
    [7, 8, 9]
]
print("Spiral Order:", *spiral_order(matrix))


OUTPUT: Spiral Order: 1 2 3 6 9 8 7 4 5
