# PRIME NUMBER

def is_prime(n):
    if n < 2:
        return False
    for i in range(2, int(n**0.5) + 1):  
        if n % i == 0:
            return False
    return True
def reverse_number(n):
    return int(str(n)[::-1])
num = int(input())
rev = reverse_number(num)
if is_prime(num) and is_prime(rev):
    print("Both are prime")
else:
    print("Condition not satisfied")

INPUT: 13
OUTPUT: Both are prime

 Check Adam Number

def reverse_number(n):
    return int(str(n)[::-1])
def is_adam_number(num):
    square_num = num ** 2
    rev_num = reverse_number(num)
    square_rev = rev_num ** 2
    rev_square = reverse_number(square_num)
    if rev_square == square_rev:
        return True
    else:
        return False
n = int(input())
if is_adam_number(n):
    print("Adam Number")
else:
    print("Not Adam Number")

