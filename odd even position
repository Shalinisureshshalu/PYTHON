n = input()

if not n.isdigit() or len(n) > 10:
    print("Invalid input")
else:
    odd = 0
    even = 0

    for i in range(len(n)):
        if (i + 1) % 2 == 1:
            odd += int(n[i])
        else:
            even += int(n[i])

    diff = odd - even

    if diff < 0:
        print("Non positive value")
    elif diff == 0:
        print("Zero")
    else:
        print(diff)
